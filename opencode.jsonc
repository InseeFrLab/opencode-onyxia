{
  "$schema": "https://opencode.ai/config.json",
  // =========================================================================
  //  NATIVE OPENCODE v2 CONFIG (https://opencode.ai/docs/migrate-v1/).
  //  Native v2 keys: providers / agents / permissions[] / mcp.servers / update.
  //  This file is NOT readable by opencode v1 (v1 and v2 share the same config
  //  locations — do not point a v1 install at it).
  //
  //  PROVIDER: self-hosted models exposed by the Onyxia platform.
  //  The gateway is Open WebUI (https://llm.lab.sspcloud.fr): OpenAI-compatible
  //  layer on /api. The base URL and key come from the environment (never
  //  hard-coded):
  //      export OPENAI_BASE_URL=https://llm.lab.sspcloud.fr/api
  //      export OPENAI_API_KEY=sk-...
  //    -> OpenCode calls {baseURL}/chat/completions
  //
  //  The "models" KEYS below are confirmed (curl .../api/models):
  //  gemma4-26b-moe, qwen3-8-27b, qwen3-6-35b-moe, qwen3-vl, qwen3-cursor,
  //  qwen3-embedding-8b, qwen-36. The gateway does not publish
  //  context/output limits; see the note in INSTALL.md if generation truncates.
  //
  //  SAMPLING + THINKING MODE (v2 change): the gateway serves qwen3-8-27b with
  //  thinking ON by default (the response carries a "reasoning_content" field).
  //  We do not rely on that default. ⚠ In v2, an agent's `request.body` is
  //  accepted but NEVER SENT to the model, so per-agent temperature / top_p /
  //  chat_template_kwargs no longer work. They live in model VARIANTS instead
  //  (`body` is forwarded verbatim into the request; variant values win over
  //  model values, nested objects are merged), and an agent selects one with
  //  `provider/model#variant`.
  // =========================================================================
  "providers": {
    "onyxia": {
      "name": "SSPCloud LLM (self-hosted)",
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "{env:OPENAI_BASE_URL}",
        "apiKey": "{env:OPENAI_API_KEY}"
      },
      "models": {
        "qwen3-8-27b": {
          "name": "Qwen3 27B MoE — code & reasoning",
          "capabilities": { "tools": true },
          // Thinking OFF by default: the code-writing agents stay fast and
          // spend their output budget on code, not on a reasoning trace.
          // The `plan` variant below re-enables it.
          "body": {
            "chat_template_kwargs": { "enable_thinking": false }
          },
          "variants": [
            {
              // build / python-ds / r-ds / mlops
              "id": "build",
              "body": { "temperature": 0.2 }
            },
            {
              // Qwen3 thinking mode: near-greedy decoding sends the reasoning
              // trace into repetition loops — use the sampling Qwen recommends.
              "id": "plan",
              "body": {
                "temperature": 0.6,
                "top_p": 0.95,
                "chat_template_kwargs": { "enable_thinking": true }
              }
            }
          ],
          "limit": { "context": 131072, "output": 32768 }
        },
        "gemma4-26b-moe": {
          "name": "Gemma 4 26B MoE — fast / review",
          "capabilities": { "tools": true },
          "variants": [
            {
              // Grading should be reproducible, not creative.
              "id": "review",
              "body": { "temperature": 0 }
            }
          ],
          "limit": { "context": 131072, "output": 16384 }
        },
        "qwen3-vl": {
          "name": "Qwen3 VL — vision (charts, diagrams, screenshots)",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"]
          },
          "variants": [
            {
              "id": "vision",
              "body": { "temperature": 0.3 }
            }
          ],
          "limit": { "context": 65536, "output": 16384 }
        }
      }
    }
  },
  // ---- Default model ----
  "model": "onyxia/qwen3-8-27b",
  // ---- Default agent at startup ----
  "default_agent": "plan",
  // ---- Update policy: notify only (v1 "autoupdate": "notify") ----
  "update": "notify",
  // =========================================================================
  //  CONTEXT BUDGET — 131k window, data science tool output.
  //  A single duckdb SUMMARIZE, a verbose pytest run or a kubectl logs easily
  //  exceeds the defaults (2000 lines / 50 KB) and burns >10k tokens per call.
  //  Truncated output is NOT lost: OpenCode writes the full text under
  //  ~/.local/share/opencode/tool-output/ and gives the model the path.
  //  CAVEAT: truncation keeps the HEAD, so prompts must bound output at the
  //  source (`| tail -n 30`) — pytest puts its verdict at the END.
  // =========================================================================
  "tool_output": {
    "max_lines": 200,
    "max_bytes": 20000
  },
  "compaction": {
    "auto": true,
    // v2 has no `prune` / `tail_turns` (v1 kept the last 4 user turns). Recent
    // context is retained by token budget instead: ~4 turns of capped tool
    // output (200 lines / 20 KB each) fits in 16k tokens. Tune if needed.
    "keep": { "tokens": 16000 }
  },
  // =========================================================================
  //  PERMISSIONS — OpenCode is NOT sandboxed: every `shell` runs on the pod.
  //  Common data science tooling is broadly allowed; anything destructive or
  //  outbound (network, k8s mutations, rm) asks for confirmation.
  //
  //  ⚠ ORDER IS SEMANTIC. v2 evaluates the ordered array and the LAST matching
  //  rule wins, so the layout must be:
  //      1. the "*" catch-all FIRST,
  //      2. then the broad allows,
  //      3. then the narrow re-restrictions LAST.
  //  Rule order across sources: lower-priority config first, then these global
  //  rules, then each agent's own `permissions` appended LAST (so an agent's
  //  rules override these). A shell pattern ending in "*" also matches the
  //  bare command (`git status *` matches `git status`).
  //
  //  NOTE: "edit" is deliberately NOT granted globally; it is granted per
  //  agent (build / python-ds / r-ds / mlops below) so read-only agents stay
  //  read-only. Actions renamed in v2: bash -> shell, task -> subagent.
  // =========================================================================
  "permissions": [
    { "action": "webfetch", "resource": "*", "effect": "ask" },
    // v2 ALLOWS paths outside the project by default (v1 asked). Restore the
    // v1 behaviour: ask before touching anything outside the project.
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    // Delegation: allow the purpose-built subagents, refuse the generic
    // "general" one — it has full write permission and no Onyxia context, so
    // it is never the right delegate here.
    { "action": "subagent", "resource": "*", "effect": "allow" },
    { "action": "subagent", "resource": "general", "effect": "deny" },
    { "action": "shell", "resource": "*", "effect": "ask" },
    // ---- broad allows: routine, non-destructive DS tooling ----
    { "action": "shell", "resource": "find *", "effect": "allow" },
    { "action": "shell", "resource": "grep *", "effect": "allow" },
    { "action": "shell", "resource": "head *", "effect": "allow" },
    { "action": "shell", "resource": "echo *", "effect": "allow" },
    { "action": "shell", "resource": "ls *", "effect": "allow" },
    { "action": "shell", "resource": "sort *", "effect": "allow" },
    { "action": "shell", "resource": "cat *", "effect": "allow" },
    { "action": "shell", "resource": "git *", "effect": "allow" },
    { "action": "shell", "resource": "uv *", "effect": "allow" },
    { "action": "shell", "resource": "pip *", "effect": "allow" },
    { "action": "shell", "resource": "pixi *", "effect": "allow" },
    { "action": "shell", "resource": "python *", "effect": "allow" },
    { "action": "shell", "resource": "python3 *", "effect": "allow" },
    { "action": "shell", "resource": "pytest*", "effect": "allow" },
    { "action": "shell", "resource": "ruff *", "effect": "allow" },
    { "action": "shell", "resource": "mypy *", "effect": "allow" },
    { "action": "shell", "resource": "Rscript *", "effect": "allow" },
    { "action": "shell", "resource": "R -e *", "effect": "allow" },
    { "action": "shell", "resource": "quarto *", "effect": "allow" },
    { "action": "shell", "resource": "make *", "effect": "allow" },
    { "action": "shell", "resource": "just *", "effect": "allow" },
    { "action": "shell", "resource": "mc *", "effect": "allow" },
    { "action": "shell", "resource": "aws s3*", "effect": "allow" },
    { "action": "shell", "resource": "mlflow *", "effect": "allow" },
    { "action": "shell", "resource": "duckdb *", "effect": "allow" },
    // Vault: read-only only; put/delete fall back to the "*" catch-all.
    { "action": "shell", "resource": "vault kv get*", "effect": "allow" },
    { "action": "shell", "resource": "vault kv list*", "effect": "allow" },
    // Argo / kubectl: browsing is free; mutations are re-restricted below.
    { "action": "shell", "resource": "argo list*", "effect": "allow" },
    { "action": "shell", "resource": "argo get*", "effect": "allow" },
    { "action": "shell", "resource": "argo logs*", "effect": "allow" },
    { "action": "shell", "resource": "argo watch*", "effect": "allow" },
    { "action": "shell", "resource": "kubectl get*", "effect": "allow" },
    { "action": "shell", "resource": "kubectl describe*", "effect": "allow" },
    { "action": "shell", "resource": "kubectl logs*", "effect": "allow" },
    { "action": "shell", "resource": "kubectl top*", "effect": "allow" },
    // ---- narrow re-restrictions: MUST stay after the allows ----
    // Outbound or irreversible: leaving the pod, or destroying local state.
    { "action": "shell", "resource": "git push*", "effect": "ask" },
    { "action": "shell", "resource": "git reset --hard*", "effect": "ask" },
    { "action": "shell", "resource": "git clean*", "effect": "ask" },
    // Submitting a workflow launches containers on the cluster.
    { "action": "shell", "resource": "argo submit*", "effect": "ask" },
    { "action": "shell", "resource": "argo delete*", "effect": "ask" },
    { "action": "shell", "resource": "kubectl apply*", "effect": "ask" },
    { "action": "shell", "resource": "kubectl create*", "effect": "ask" },
    { "action": "shell", "resource": "kubectl delete*", "effect": "ask" },
    { "action": "shell", "resource": "docker *", "effect": "ask" },
    // S3 writes/deletes: `ls`/`cp` inward stay free via "aws s3*" above.
    { "action": "shell", "resource": "aws s3 rm*", "effect": "ask" },
    { "action": "shell", "resource": "aws s3 sync*", "effect": "ask" },
    { "action": "shell", "resource": "mc rm*", "effect": "ask" },
    // Deletions always confirm (covers `rm -rf <glob>` too). Regenerate
    // outputs via the pipeline rather than deleting data/artifacts.
    { "action": "shell", "resource": "rm *", "effect": "ask" },
    { "action": "shell", "resource": "curl *", "effect": "ask" },
    { "action": "shell", "resource": "wget *", "effect": "ask" },
    { "action": "skill", "resource": "*", "effect": "allow" }
  ],
  // =========================================================================
  //  AGENTS — 2 primary agents (Tab to switch) + 5 subagents, delegated
  //  automatically based on their "description" or invoked via @name.
  //  Each agent's system prompt lives in ./prompts/<agent>.md
  //
  //  `plan` is the only agent running in thinking mode (Qwen3, `#plan`
  //  variant): planning is where an explicit reasoning trace pays off.
  //  `reviewer` stays on Gemma 4 on purpose — a second model gives a genuinely
  //  different point of view.
  //
  //  ⚠ "system" is inline prompt TEXT, not a path (v1 called it "prompt"). A
  //  bare "./prompts/x.md" is sent to the model verbatim as a 19-character
  //  system prompt. Use {file:...}: it resolves relative to THIS file's
  //  directory (so the same string works in the repo and in
  //  ~/.config/opencode) and OpenCode refuses to start if the target is
  //  missing. Every agent starts from ./prompts/shared/base.md.
  //
  //  ./prompts/shared/completion-contract.md goes ONLY to the agents that
  //  change files. `reviewer` grades against that contract — it must not be
  //  told when it may declare itself done.
  //
  //  python-ds / r-ds / mlops deliberately have NO tool restriction:
  //  they must execute and verify code; the global shell allowlist above
  //  (rm/curl/kubectl apply/docker/argo submit on "ask") keeps them in check.
  //
  //  Agent `permissions` are appended AFTER the global ones (last match wins).
  // =========================================================================
  "agents": {
    // Session titles: cheap model (v1 "small_model").
    "title": {
      "model": "onyxia/gemma4-26b-moe"
    },
    "build": {
      "mode": "primary",
      "model": "onyxia/qwen3-8-27b#build",
      "system": "{file:./prompts/shared/base.md}\n\n{file:./prompts/build.md}\n\n{file:./prompts/shared/completion-contract.md}",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "allow" }
      ]
    },
    "plan": {
      "mode": "primary",
      "model": "onyxia/qwen3-8-27b#plan",
      "system": "{file:./prompts/shared/base.md}\n\n{file:./prompts/plan.md}",
      "permissions": [
        // Read-only EXCEPT its own plan files: that is where the acceptance
        // list and the evidence log live, and `build` reads them from there.
        // Order matters: deny-all first, then the narrow allow.
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "edit", "resource": ".opencode/plans/*.md", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "ask" },
        { "action": "shell", "resource": "git status", "effect": "allow" },
        { "action": "shell", "resource": "git log*", "effect": "allow" },
        { "action": "shell", "resource": "git diff*", "effect": "allow" },
        { "action": "shell", "resource": "ls *", "effect": "allow" },
        { "action": "shell", "resource": "aws s3 ls*", "effect": "allow" },
        { "action": "shell", "resource": "mc ls*", "effect": "allow" },
        { "action": "shell", "resource": "duckdb *", "effect": "allow" }
      ]
    },
    "python-ds": {
      "mode": "subagent",
      "description": "Python data science / ML specialist on Onyxia (uv, ruff, polars, pandas, scikit-learn, pyarrow, s3fs). Use to write or refactor Python code for analysis, modelling, or pipelines.",
      "model": "onyxia/qwen3-8-27b#build",
      "system": "{file:./prompts/shared/base.md}\n\n{file:./prompts/python-ds.md}\n\n{file:./prompts/shared/completion-contract.md}",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "allow" }
      ]
    },
    "r-ds": {
      "mode": "subagent",
      "description": "R data science specialist (tidyverse, data.table, targets, renv, testthat, aws.s3, arrow). Use for any R code for analysis, modelling, or reproducible pipelines.",
      "model": "onyxia/qwen3-8-27b#build",
      "system": "{file:./prompts/shared/base.md}\n\n{file:./prompts/r-ds.md}\n\n{file:./prompts/shared/completion-contract.md}",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "allow" }
      ]
    },
    "mlops": {
      "mode": "subagent",
      "description": "Onyxia MLOps engineer: MLflow experiment tracking, parallel training via Argo Workflows (argo submit, CronWorkflow), GitOps deployment via ArgoCD, model packaging and productionization. Use to industrialize/deploy a model or schedule recurring jobs.",
      "model": "onyxia/qwen3-8-27b#build",
      "system": "{file:./prompts/shared/base.md}\n\n{file:./prompts/mlops.md}\n\n{file:./prompts/shared/completion-contract.md}",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "allow" }
      ]
    },
    "reviewer": {
      "mode": "subagent",
      "description": "Fresh-context grader AND code reviewer (read-only). Give it the path to an acceptance file (usually .opencode/plans/<slug>.md) plus `git diff --stat`: it re-runs every check itself and returns PASS/FAIL per acceptance item (blocking), followed by quality/reproducibility/security findings (advisory). Invoke at the END of any task that changed a file, before telling the user it is done. Never edits, never commits, never deploys.",
      "model": "onyxia/gemma4-26b-moe#review",
      "steps": 40,
      "system": "{file:./prompts/shared/base.md}\n\n{file:./prompts/reviewer.md}",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "webfetch", "resource": "*", "effect": "deny" },
        { "action": "websearch", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" },
        // Catch-all is "deny", not "ask": a subagent has no user to ask, so an
        // "ask" here would stall. Same ordering rule as the global block —
        // broad first, narrow last.
        { "action": "shell", "resource": "*", "effect": "deny" },
        // -- inspect
        { "action": "shell", "resource": "ls *", "effect": "allow" },
        { "action": "shell", "resource": "cat *", "effect": "allow" },
        { "action": "shell", "resource": "head *", "effect": "allow" },
        { "action": "shell", "resource": "tail *", "effect": "allow" },
        { "action": "shell", "resource": "wc *", "effect": "allow" },
        { "action": "shell", "resource": "grep *", "effect": "allow" },
        { "action": "shell", "resource": "rg *", "effect": "allow" },
        { "action": "shell", "resource": "find *", "effect": "allow" },
        { "action": "shell", "resource": "git status", "effect": "allow" },
        { "action": "shell", "resource": "git status*", "effect": "allow" },
        { "action": "shell", "resource": "git diff*", "effect": "allow" },
        { "action": "shell", "resource": "git log*", "effect": "allow" },
        { "action": "shell", "resource": "git show*", "effect": "allow" },
        // -- actually re-run the checks (this is the point of the agent)
        { "action": "shell", "resource": "uv run *", "effect": "allow" },
        { "action": "shell", "resource": "uv sync*", "effect": "allow" },
        { "action": "shell", "resource": "uv tree*", "effect": "allow" },
        { "action": "shell", "resource": "python *", "effect": "allow" },
        { "action": "shell", "resource": "python3 *", "effect": "allow" },
        { "action": "shell", "resource": "pytest*", "effect": "allow" },
        { "action": "shell", "resource": "ruff *", "effect": "allow" },
        { "action": "shell", "resource": "mypy *", "effect": "allow" },
        { "action": "shell", "resource": "Rscript *", "effect": "allow" },
        { "action": "shell", "resource": "R -e *", "effect": "allow" },
        { "action": "shell", "resource": "quarto render*", "effect": "allow" },
        { "action": "shell", "resource": "quarto check*", "effect": "allow" },
        { "action": "shell", "resource": "duckdb *", "effect": "allow" },
        { "action": "shell", "resource": "mlflow *", "effect": "allow" },
        { "action": "shell", "resource": "aws s3 ls*", "effect": "allow" },
        { "action": "shell", "resource": "mc ls*", "effect": "allow" },
        { "action": "shell", "resource": "make *", "effect": "allow" },
        { "action": "shell", "resource": "just *", "effect": "allow" },
        // -- narrow denies AFTER the allows: nothing mutating, nothing
        //    outbound, no dependency changes. `uv run *` still lets it
        //    execute project code — irreducible, since re-running the tests
        //    IS the job; this list blocks the categorically wrong actions
        //    rather than pretending to sandbox.
        { "action": "shell", "resource": "git commit*", "effect": "deny" },
        { "action": "shell", "resource": "git push*", "effect": "deny" },
        { "action": "shell", "resource": "git checkout*", "effect": "deny" },
        { "action": "shell", "resource": "git reset*", "effect": "deny" },
        { "action": "shell", "resource": "git clean*", "effect": "deny" },
        { "action": "shell", "resource": "rm *", "effect": "deny" },
        { "action": "shell", "resource": "mv *", "effect": "deny" },
        { "action": "shell", "resource": "aws s3 cp*", "effect": "deny" },
        { "action": "shell", "resource": "aws s3 rm*", "effect": "deny" },
        { "action": "shell", "resource": "aws s3 sync*", "effect": "deny" },
        { "action": "shell", "resource": "mc cp*", "effect": "deny" },
        { "action": "shell", "resource": "mc rm*", "effect": "deny" },
        { "action": "shell", "resource": "argo submit*", "effect": "deny" },
        { "action": "shell", "resource": "kubectl apply*", "effect": "deny" },
        { "action": "shell", "resource": "kubectl delete*", "effect": "deny" },
        { "action": "shell", "resource": "docker *", "effect": "deny" },
        { "action": "shell", "resource": "pip install*", "effect": "deny" },
        { "action": "shell", "resource": "uv add*", "effect": "deny" }
      ]
    },
    "dataviz-vision": {
      "mode": "subagent",
      "description": "Visual analysis (vision model): reads screenshots, matplotlib/ggplot charts, architecture diagrams, or dashboards to interpret them or suggest improvements. Use whenever an image is provided.",
      "model": "onyxia/qwen3-vl#vision",
      "system": "{file:./prompts/dataviz-vision.md}",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "webfetch", "resource": "*", "effect": "deny" }
      ]
    }
  },
  // =========================================================================
  //  MCP (optional) — disabled by default.
  //  Careful: a "local" MCP server executes a command on the pod;
  //  a "remote" one sends context outside the platform.
  //  Enable only knowingly (confidentiality of Insee data).
  //  v2 shape: servers live under `mcp.servers`; `enabled:false` -> `disabled:true`.
  // =========================================================================
  "mcp": {
    "servers": {
      "excalidraw": {
        "type": "remote",
        "url": "https://api.excalidraw.com/api/v1/mcp",
        "disabled": true,
        "headers": {
          "Authorization": "Bearer {env:EXCALIDRAW_API_KEY}"
        }
      },
      "datagouv": {
        "type": "remote",
        "url": "https://mcp.data.gouv.fr/mcp",
        "disabled": true
      }
    }
  }
}
